# Valores PÚBLICOS: todo lo que lleva el prefijo EXPO_PUBLIC_ se incluye en el bundle
# de la app y cualquiera puede leerlo. NUNCA pongas aquí un secreto (service_role,
# keys de proveedores de IA, etc.).
# Copia este archivo a .env (ignorado por git) y completa los valores.

# mock = adaptadores locales sin backend | live = Supabase + API
EXPO_PUBLIC_DATA_MODE=mock
# Emulador: http://10.0.2.2:8787 · Dispositivo físico: http://<IP-LAN-del-PC>:8787 · Release: solo HTTPS
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
# La anon key es pública por diseño (la protege RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

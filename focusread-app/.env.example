# Plantilla SIN valores reales: copia este archivo a .env (ignorado por git) y complétalo.
# Todo lo que lleva el prefijo EXPO_PUBLIC_ se incluye en el bundle de la app y cualquiera puede
# leerlo. NUNCA pongas aquí un secreto (service_role, keys de proveedores de IA, etc.).

# mock = adaptadores locales sin backend | live = Supabase + API
EXPO_PUBLIC_DATA_MODE=mock

# API de FocusRead. Producción (HTTPS): ver docs/F8_PRUEBA_LIVE.md
# Desarrollo: emulador http://10.0.2.2:8787 · dispositivo físico http://<IP-LAN-del-PC>:8787
# En release solo se acepta HTTPS.
EXPO_PUBLIC_API_URL=

# Proyecto Supabase (Settings → API). La clave pública (anon / publishable) la protege RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Voces de alta calidad en la nube: 1 = activar (cuando el backend tenga /v1/tts). Apagado por defecto.
# EXPO_PUBLIC_CLOUD_TTS=
